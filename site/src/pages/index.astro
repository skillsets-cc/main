---
export const prerender = true;

import BaseLayout from '@layouts/BaseLayout.astro';
import SkillsetGrid from '@components/SkillsetGrid';
import TerminalDemo from '@components/TerminalDemo.astro';
import SurfaceLayers from '@components/SurfaceLayers.astro';
import { getSkillsets } from '@/lib/data';

const skillsets = getSkillsets();
---

<BaseLayout title="Skillsets.cc">
  <!-- Snap scroll container -->
  <div class="h-screen overflow-y-auto snap-y snap-mandatory">

    <!-- Hero section — full viewport -->
    <section class="snap-start h-screen flex flex-col justify-start relative md:pr-16 overflow-hidden">
      <div class="max-w-3xl mx-auto px-4 pt-[10vh] md:pt-[18vh]">

        <!-- Hook -->
        <h1 class="text-5xl md:text-6xl text-text-ink font-serif font-extrabold leading-tight mb-8">
          The short list.
        </h1>

        <!-- Definition -->
        <p class="text-lg text-text-secondary font-serif leading-relaxed mb-3">
          A <strong class="text-text-ink">skillset</strong> is an integrated stack of Claude Code primitives and custom support stacks — <a href="/about" class="text-accent hover:underline">audited</a>, verified, and maintained by the author.
        </p>

        <!-- Registry -->
        <p class="text-lg text-text-secondary font-serif leading-relaxed mb-3">
          <strong class="text-text-ink">Skillsets.cc</strong> is a curated, quality-gated registry.
        </p>

        <!-- Install -->
        <p class="text-lg text-text-secondary font-serif leading-relaxed mb-6">
          Install our plugin.
        </p>
        <TerminalDemo />


      </div>

      <!-- Down chevron -->
      <a href="#registry" id="hero-chevron"
         class="fixed bottom-10 left-1/2 -translate-x-1/2 z-40 text-accent transition-colors"
         style="animation: bounce 2s infinite, glow-pulse 2s infinite;"
         aria-label="Scroll to registry"
      >
        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </a>
    </section>

    <!-- Registry section — snaps to top -->
    <section id="registry" class="snap-start min-h-screen">
      <div class="max-w-5xl mx-auto px-4 pb-20">
        <div class="sticky top-0 z-40 relative bg-black/95 rounded-sm specular-border border border-accent/20 mb-6">
          <SurfaceLayers />
          <div class="relative z-10 px-4 pt-4 pb-3">
            <h3 class="text-base font-bold uppercase tracking-wider text-accent font-mono">Registry</h3>
            <p class="text-sm text-text-tertiary font-serif mt-2">
              *Skillsets come with all the guarantees of probabilistic space — as with any OSS, verify before you trust.
            </p>
          </div>
        </div>

        <SkillsetGrid client:load skillsets={skillsets} />
      </div>
    </section>

  </div>

  <script>
    // Hide hero chevron when scrolled past hero
    const heroChevron = document.getElementById('hero-chevron');
    const snapContainer = document.querySelector('.snap-y') as HTMLElement;
    if (heroChevron && snapContainer) {
      snapContainer.addEventListener('scroll', () => {
        const show = snapContainer.scrollTop < window.innerHeight * 0.5;
        heroChevron.style.visibility = show ? 'visible' : 'hidden';
        heroChevron.classList.toggle('pointer-events-none', !show);
      });
    }
  </script>

  <style is:global>
    /* Index page: snap container handles all scrolling, prevent outer body scroll */
    html, body { height: 100vh; overflow: hidden; }
  </style>
</BaseLayout>
