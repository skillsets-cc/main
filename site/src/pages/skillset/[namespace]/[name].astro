---
import BaseLayout from '@layouts/BaseLayout.astro';
import StarButton from '@components/StarButton';
import DownloadCount from '@components/DownloadCount';
import CopyCommand from '@components/CopyCommand';
import ProofGallery from '@components/ProofGallery.astro';
import MediaGallery from '@components/MediaGallery.astro';
import { getSkillsetById } from '@/lib/data';
import { sanitizeHtml, sanitizeUrl } from '@/lib/sanitize';
import { marked } from 'marked';
import { gfmHeadingId } from 'marked-gfm-heading-id';

marked.use(gfmHeadingId());

const { namespace, name } = Astro.params;

if (!namespace || !name) {
  return Astro.redirect('/404');
}

const skillsetId = `${namespace}/${name}`;
const skillset = getSkillsetById(skillsetId);

if (!skillset) {
  return Astro.redirect('/404');
}

const authorUrl = sanitizeUrl(skillset.author.url || `https://github.com/${skillset.author.handle.replace('@', '')}`);
const installCommand = `/install ${skillset.name}`;

// Fetch README from GitHub at runtime
const encodedPath = encodeURIComponent(namespace) + '/' + encodeURIComponent(name);
const readmeFile = Object.keys(skillset.files).find(f => /^content\/README_[^/]+\.md$/i.test(f));
const readmeUrl = readmeFile
  ? `https://raw.githubusercontent.com/skillsets-cc/main/main/skillsets/${encodedPath}/${readmeFile}`
  : `https://raw.githubusercontent.com/skillsets-cc/main/main/skillsets/${encodedPath}/content/README.md`;

let readmeContent: string | null = null;
try {
  const response = await fetch(readmeUrl);
  if (response.ok) {
    readmeContent = await response.text();
    readmeContent = readmeContent.replace(/^#\s+.+\n+/, '');
  }
} catch { /* fall through to description */ }
const readmeHtml = sanitizeHtml(await marked.parse(readmeContent ?? skillset.description));

const STATUS_COLORS: Record<string, string> = {
  active: 'bg-status-success',
  deprecated: 'bg-status-warning',
};
const statusColor = STATUS_COLORS[skillset.status] ?? 'bg-text-tertiary';
---

<BaseLayout title={`${skillset.name} - Skillsets.cc`}>
  <article class="max-w-4xl mx-auto px-4 py-12">
    <div id="header-sentinel" class="h-px w-full" aria-hidden="true"></div>
    <div
      id="sticky-header"
      data-stuck="false"
      class="sticky z-50 relative bg-black/80 rounded-sm specular-border border border-accent/20 px-4 mb-0"
      style="top: var(--vv-offset, 0px);"
    >
      <div class="surface-speckle"></div>
      <div class="surface-gloss"></div>
      <div class="relative z-10 flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
        <h1 class="text-4xl font-bold font-serif text-text-ink">
          {skillset.name} <span class="text-lg font-normal text-text-secondary">by <a href={authorUrl} class="text-accent hover:underline" target="_blank" rel="noopener noreferrer">{skillset.author.handle}</a></span>
        </h1>

        <div data-stuck-hide class="flex items-center gap-2">
          <DownloadCount
            client:load
            skillsetId={skillsetId}
          />
          <StarButton
            client:load
            skillsetId={skillsetId}
            initialStars={skillset.stars}
          />
        </div>
      </div>
    </div>

    <header class="mb-8 mt-4">
      <div class="flex items-center gap-4 text-sm text-text-tertiary font-mono mb-4">
        <span class="flex items-center gap-1">
          v{skillset.version}
        </span>
        <span class="flex items-center gap-1">
          <span class={`w-2 h-2 rounded-sm ${statusColor}`}></span>
          {skillset.status}
        </span>
      </div>

      <p class="text-xl text-text-secondary mb-6 font-serif leading-relaxed">{skillset.description}</p>

      <div class="flex flex-wrap gap-2 mb-6">
        {skillset.tags.map((tag) => (
          <span class="px-3 py-1 text-sm font-mono border border-accent/20 bg-black text-text-secondary rounded-sm">
            {tag}
          </span>
        ))}
      </div>
    </header>

    <section class="mb-6">
      <p class="text-sm text-text-secondary font-serif mb-2">
        In Claude Code, add the skillset plugin from the skillsets.cc marketplace, and run:
      </p>
      <CopyCommand client:load command={installCommand} />
      <p class="mt-1.5 text-sm text-text-tertiary font-serif italic">
        Reviewed best-effort with no security guarantees. You are the final quality gate, as with any OSS.
      </p>
    </section>

    <ProofGallery
      productionLinks={skillset.verification.production_links}
      hasAuditReport={!!skillset.verification.audit_report}
      skillsetId={skillsetId}
    />

    <div class="space-y-6">
      <section class="p-6 rounded-none">
        <h2 class="text-sm font-bold font-mono mb-4 text-text-ink uppercase tracking-wider border-b border-border-ink pb-2 inline-block">README</h2>
        <article class="prose max-w-none" set:html={readmeHtml} />
      </section>

      {skillset.mcp_servers && skillset.mcp_servers.length > 0 && (
        <section class="surface-panel specular-border border border-accent/20 p-4">
          <div class="surface-speckle"></div>
          <div class="surface-gloss"></div>
          <div class="relative z-10 flex flex-col gap-2 md:flex-row md:gap-6">
            <h2 class="text-sm font-bold font-mono text-text-ink uppercase tracking-wider whitespace-nowrap">MCP Servers</h2>
            <div class="flex-1 min-w-0">
              <div class="flex flex-wrap gap-x-8 gap-y-2">
                {skillset.mcp_servers.map(server => (
                  <div class="flex items-start gap-2">
                    <div class="w-1 self-stretch bg-accent flex-shrink-0"></div>
                    <div>
                      {server.type === 'docker' ? (
                        <>
                          <p class="font-bold font-mono text-sm text-text-ink">{server.image}</p>
                          <p class="text-xs text-text-secondary font-serif">
                            {server.mcp_reputation} <span class="italic">({server.researched_at})</span>
                          </p>
                          {server.servers && server.servers.length > 0 && (
                            <p class="text-xs text-text-secondary font-serif">
                              Runs: {server.servers.map(s => s.name).join(', ')}
                            </p>
                          )}
                        </>
                      ) : (
                        <>
                          <p class="font-bold font-serif text-sm text-text-ink">
                            {server.name}
                            <span class="text-text-tertiary font-normal text-xs"> ({server.type})</span>
                          </p>
                          {server.command && (
                            <p class="text-xs text-text-secondary font-mono">
                              {server.command} {(server.args || []).join(' ')}
                            </p>
                          )}
                          {server.url && (
                            <p class="text-xs text-text-secondary font-mono">{server.url}</p>
                          )}
                          <p class="text-xs text-text-secondary font-serif">
                            {server.mcp_reputation} <span class="italic">({server.researched_at})</span>
                          </p>
                        </>
                      )}
                    </div>
                  </div>
                ))}
              </div>
              <p class="text-xs text-text-tertiary mt-2 font-serif italic">
                Packages fetched at runtime and may have changed since audit.
              </p>
            </div>
          </div>
        </section>
      )}

      <section class="surface-panel specular-border border border-accent/20 p-4">
        <div class="surface-speckle"></div>
        <div class="surface-gloss"></div>
        <div class="relative z-10 flex flex-col gap-2 md:flex-row md:gap-6">
          <h2 class="text-sm font-bold font-mono text-text-ink uppercase tracking-wider whitespace-nowrap">Compatibility</h2>
          <div class="flex-1 min-w-0 flex flex-wrap gap-x-8 gap-y-1">
            <div>
              <dt class="text-xs uppercase tracking-wider font-bold text-text-tertiary">Claude Code Version</dt>
              <dd class="font-mono text-sm text-text-ink">{skillset.compatibility.claude_code_version}</dd>
            </div>
            <div>
              <dt class="text-xs uppercase tracking-wider font-bold text-text-tertiary">Languages</dt>
              <dd class="font-mono text-sm text-text-ink">{skillset.compatibility.languages.join(', ')}</dd>
            </div>
            {skillset.compatibility.requirements && skillset.compatibility.requirements.length > 0 && (
              <div>
                <dt class="text-xs uppercase tracking-wider font-bold text-text-tertiary">Requirements</dt>
                <dd class="font-mono text-sm text-text-ink">{skillset.compatibility.requirements.join(', ')}</dd>
              </div>
            )}
          </div>
        </div>
      </section>

      {skillset.context_image_url && (
        <MediaGallery items={[{ url: skillset.context_image_url }]} />
      )}
    </div>

    <div class="mt-8 text-center">
      <a href="/" class="text-accent hover:underline font-serif italic">
        ← Back to all skillsets
      </a>
    </div>
  </article>

<script>
  // Stuck detection via IntersectionObserver
  const sentinel = document.getElementById('header-sentinel');
  const header = document.getElementById('sticky-header');

  if (sentinel && header) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        const stuck = String(!entry.isIntersecting);
        header.dataset.stuck = stuck;
        document.documentElement.dataset.headerStuck = stuck;
      },
      { threshold: 0 }
    );
    observer.observe(sentinel);

    // Continuously track header height through CSS transitions
    function updateHeaderH() {
      document.documentElement.style.setProperty(
        '--header-h',
        header.getBoundingClientRect().height + 'px'
      );
    }

    new ResizeObserver(updateHeaderH).observe(header);
    // Re-measure after CSS transitions (padding/font-size) complete —
    // ResizeObserver alone may miss padding-driven height changes
    header.addEventListener('transitionend', updateHeaderH);
    updateHeaderH(); // immediate measurement before first RO callback
  }

  // Visual viewport offset for mobile URL bar
  function updateVvOffset() {
    if (window.visualViewport) {
      const offset = window.visualViewport.offsetTop;
      document.documentElement.style.setProperty('--vv-offset', offset + 'px');
    }
  }

  if (window.visualViewport) {
    window.visualViewport.addEventListener('resize', updateVvOffset);
    window.visualViewport.addEventListener('scroll', updateVvOffset);
    updateVvOffset();
  }
</script>

</BaseLayout>
